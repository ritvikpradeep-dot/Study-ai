generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(USER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  accounts     Account[]
  sessions     Session[]
  documents     Document[]
  ownedTeams    Team[]        @relation("TeamOwner")
  teamMembers   TeamMember[]
  aiUsageLogs   AiUsageLog[]
  notes             Note[]
  highlights        Highlight[]
  drawings          Drawing[]
  stickyNotes       StickyNote[]
  roomMessages      RoomMessage[]
  reactions         Reaction[]
  activityLogEntries ActivityLogEntry[]
  pomodoroSessionsStarted PomodoroSession[]
  editPermissions   EditPermission[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum DocumentStatus {
  processing
  ready
  error
}

model Document {
  id                String         @id @default(cuid())
  userId            String
  teamId            String?
  title             String
  filename          String
  storageUrl        String
  fileSize          Int
  pageCount         Int?
  textContent       String?
  status            DocumentStatus @default(processing)
  errorMessage      String?
  // Persisted shared summary (host-generated for room docs); the free-form
  // summarizer-panel output stays ephemeral/per-viewer and is not this field.
  summary           String?
  summaryGeneratedAt DateTime?
  createdAt         DateTime       @default(now())

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  team       Team?         @relation(fields: [teamId], references: [id], onDelete: SetNull)
  messages   ChatMessage[]
  quizzes    Quiz[]
  notes       Note[]
  highlights  Highlight[]
  drawings    Drawing[]
  stickyNotes StickyNote[]
}

// One note per (document, user) — in a team-shared document, each member
// keeps their own notes rather than overwriting a shared one.
model Note {
  id         String   @id @default(cuid())
  documentId String
  userId     String
  content    String   @default("")
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([documentId, userId])
}

// Not personally-identifiable data — a small fixed palette index assigned
// deterministically per author (see src/lib/annotation-colors.ts) so
// highlights/drawings don't need a stored color-assignment table.
model Highlight {
  id          String   @id @default(cuid())
  documentId  String
  authorId    String
  page        Int
  textSnippet String
  startOffset Int
  endOffset   Int
  color       String
  createdAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

enum DrawingTool {
  PEN
  RECTANGLE
  CIRCLE
  ARROW
}

// The "ink" rendering style, orthogonal to DrawingTool (which is the shape
// being drawn — freehand vs. rectangle/circle/arrow). A highlighter or
// marker rectangle is a legitimate combination (e.g. highlighting a block),
// so this applies uniformly across all DrawingTool values rather than being
// restricted to PEN.
enum DrawingPenType {
  PEN
  HIGHLIGHTER
  MARKER
}

model Drawing {
  id          String         @id @default(cuid())
  documentId  String
  authorId    String
  page        Int
  tool        DrawingTool
  penType     DrawingPenType @default(PEN)
  // Array of {x,y} points as fractions (0-1) of the page's rendered
  // width/height, so a stroke stays aligned across zoom/resize. For PEN it's
  // the full freehand path; for shapes it's just the drag start/end corners.
  pathData    Json
  color       String
  strokeWidth Int            @default(3)
  createdAt   DateTime       @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

// Draggable annotation anchored to a point on a page — same solo/room
// pattern as Highlight/Drawing/Note: no roomId column, visibility derives
// from the parent Document's teamId via canAccessDocument.
model StickyNote {
  id         String   @id @default(cuid())
  documentId String
  authorId   String
  page       Int
  x          Float
  y          Float
  content    String   @default("")
  color      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

enum ReactionTargetType {
  NOTE
  HIGHLIGHT
}

// No DB relation to Note/Highlight — a reaction can target either, and
// Prisma has no polymorphic-relation support, so targetId is a plain
// pointer. Callers that delete a Note/Highlight are responsible for also
// deleting its Reactions (see the highlight DELETE route).
model Reaction {
  id         String             @id @default(cuid())
  targetType ReactionTargetType
  targetId   String
  authorId   String
  emoji      String
  createdAt  DateTime           @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([targetType, targetId, authorId, emoji])
}

enum ActivityAction {
  DOCUMENT_UPLOADED
  NOTE_ADDED
  HIGHLIGHT_ADDED
  DRAWING_ADDED
  STICKY_NOTE_ADDED
  MEMBER_JOINED
  MEMBER_LEFT
  MEMBER_KICKED
  EDIT_ACCESS_GRANTED
  EDIT_ACCESS_REVOKED
  POMODORO_STARTED
  POMODORO_STOPPED
  ROOM_CLOSED
  INVITE_CODE_REGENERATED
}

model ActivityLogEntry {
  id        String         @id @default(cuid())
  teamId    String
  actorId   String
  action    ActivityAction
  metadata  Json?
  createdAt DateTime       @default(now())

  team  Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)
}

enum PomodoroPhase {
  FOCUS
  BREAK
}

// One row per room holding the current timer state; clients compute the
// live countdown from phaseStartedAt between polls rather than the server
// pushing per-second ticks.
model PomodoroSession {
  id                   String        @id @default(cuid())
  teamId               String        @unique
  startedById          String
  focusMinutes         Int           @default(25)
  breakMinutes         Int           @default(5)
  currentPhase         PomodoroPhase @default(FOCUS)
  currentSessionNumber Int           @default(1)
  totalSessions        Int           @default(4)
  phaseStartedAt        DateTime     @default(now())
  isRunning             Boolean      @default(true)
  updatedAt             DateTime     @updatedAt

  team      Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  startedBy User @relation(fields: [startedById], references: [id], onDelete: Cascade)
}

// Explicit grant of annotation write access to a non-host room member.
// Absence of a row (or canEdit: false) means view-only — the host always
// has implicit edit access regardless of this table. Revoking sets
// canEdit: false rather than deleting the row, keeping grantedByHostAt as a
// record of the last permission change.
model EditPermission {
  id             String   @id @default(cuid())
  teamId         String
  userId         String
  canEdit        Boolean  @default(true)
  grantedByHostAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

enum TeamRole {
  OWNER
  MEMBER
}

model Team {
  id         String    @id @default(cuid())
  name       String
  ownerId    String
  inviteCode String    @unique
  createdAt  DateTime  @default(now())
  // Reversible archive flag ("ending/closing a room") — blocks new
  // uploads/joins/edits but keeps existing history visible, rather than
  // deleting the room outright.
  closedAt   DateTime?

  owner           User               @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members         TeamMember[]
  documents       Document[]
  messages        RoomMessage[]
  activityLog     ActivityLogEntry[]
  pomodoroSession PomodoroSession?
  editPermissions EditPermission[]
}

// The room's human group chat — distinct from ChatMessage, which is the
// per-document AI Q&A thread.
model RoomMessage {
  id        String   @id @default(cuid())
  teamId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  role     TeamRole @default(MEMBER)
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

enum AiFeature {
  chat
  summarize
  quiz_generate
  quiz_grade
  mindmap
}

model AiUsageLog {
  id               String    @id @default(cuid())
  userId           String
  documentId       String?
  feature          AiFeature
  model            String?
  promptTokens     Int?
  completionTokens Int?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ChatRole {
  user
  assistant
}

model ChatMessage {
  id         String   @id @default(cuid())
  documentId String
  role       ChatRole
  content    String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

enum QuizSource {
  document
  summary
  custom
}

enum QuestionType {
  mcq
  short_answer
}

model Quiz {
  id         String     @id @default(cuid())
  documentId String
  title      String
  source     QuizSource
  difficulty String?
  createdAt  DateTime   @default(now())

  document  Document      @relation(fields: [documentId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model QuizQuestion {
  id             String       @id @default(cuid())
  quizId         String
  type           QuestionType
  orderIndex     Int
  prompt         String
  options        String? // JSON-encoded string[] for mcq
  correctAnswer  String
  explanation    String

  quiz    Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]
}

model QuizAttempt {
  id        String   @id @default(cuid())
  quizId    String
  userId    String
  score     Int
  total     Int
  createdAt DateTime @default(now())

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]
}

model QuizAnswer {
  id         String  @id @default(cuid())
  attemptId  String
  questionId String
  userAnswer String
  isCorrect  Boolean
  feedback   String?

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
}
